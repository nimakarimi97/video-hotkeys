{
  "manifest_version": 3,
  "name": "Video Seek Hotkey",
  "version": "1.3",
  "description": "Adds video seek and playback-speed hotkeys on websites.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Video Seek Hotkey",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}