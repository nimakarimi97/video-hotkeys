{
  "manifest_version": 3,
  "name": "Video Hotkeys",
  "version": "1.4.0",
  "description": "Control HTML5 video seeking and playback speed with simple keyboard shortcuts.",
  "homepage_url": "https://nimakarimi.me",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Video Hotkeys",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}